# opspilot api environment — copy to .env and fill in real values.
# vars are validated at boot by joi (apps/api/src/config/env.schema.ts); a
# missing/invalid required value fails fast.

# better-auth signing secret — required, min 32 chars, no default.
# generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# explicit public url the app is served from — required, must be a valid uri.
# local dev: http://localhost:3000 ; prod: https://opspilot.example.com
BETTER_AUTH_URL=http://localhost:3000

# master aes-256 key for at-rest credential encryption — required, no default.
# 32 raw bytes as base64 (44 chars). generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# origins better-auth trusts — required, comma-separated for multiple.
# e.g. https://opspilot.example.com or https://opspilot.example.com,http://localhost:4200
TRUSTED_ORIGINS=https://opspilot.example.com

# optional — sensible defaults applied when omitted:
# DATABASE_PATH=./data/opspilot.db
# DATABASE_BACKUP_RETENTION=5
# NODE_ENV=development
# PORT=3000
# SESSION_EXPIRES_IN=604800   # seconds (7 days)
# SESSION_UPDATE_AGE=86400    # seconds (1 day)
