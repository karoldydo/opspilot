# normalize all text files to LF in the repo and on checkout
# (overrides a local core.autocrlf=true, so checkouts are LF on every OS)
* text=auto eol=lf

# explicit binaries — never apply eol conversion
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.svg   text eol=lf
*.woff  binary
*.woff2 binary
*.ttf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.gz    binary
